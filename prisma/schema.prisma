// Câmara de Comércio Brasil–Omã (CTB) — database schema
// Prisma 7 · PostgreSQL (Railway / AWS RDS)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Mensagens enviadas pelo formulário de contato do site.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  message   String
  locale    String   @default("pt")
  ip        String?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

/// Pedidos de associação — também funciona como conta do associado (Área do Membro).
model MembershipApplication {
  id           String            @id @default(cuid())
  name         String
  email        String            @unique
  passwordHash String?
  company      String
  role         String?
  sector       String?
  country      String?
  phone        String?
  message      String?
  status       ApplicationStatus @default(PENDING)
  createdAt    DateTime          @default(now())

  @@index([status])
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Substituições de conteúdo do site (textos/imagens editados pelo admin).
/// Uma única linha (id fixo "singleton"): "data" é um objeto profundo, no mesmo
/// formato de content.ts, contendo só os campos que o admin alterou. O site
/// mescla isso por cima dos padrões de content.ts em tempo de execução
/// (ver lib/contentOverrides.ts) — nunca sobrescreve o código-fonte.
model SiteContent {
  id        String   @id @default("singleton")
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt
}

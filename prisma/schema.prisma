// Câmara de Comércio Brasil–Omã (CTB) — database schema
// Prisma 7 · PostgreSQL (Railway / AWS RDS)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Mensagens enviadas pelo formulário de contato do site.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  message   String
  locale    String   @default("pt")
  ip        String?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

/// Pedidos de associação — também funciona como conta do associado (Área do Membro).
/// Fluxo completo: pré-cadastro (name/email/company/senha) -> Portal do Candidato
/// (7 etapas, salvas nos campos Json abaixo) -> análise de compliance -> aprovação
/// -> finalizar associação (categoria + pagamento, Stripe integrado depois) -> ativo.
model MembershipApplication {
  id           String            @id @default(cuid())
  name         String
  email        String            @unique
  passwordHash String?
  company      String
  role         String?
  sector       String?
  country      String?
  phone        String?
  message      String?
  status       ApplicationStatus @default(INCOMPLETE)
  createdAt    DateTime          @default(now())

  /// Logo/ícone da empresa, enviado pelo próprio associado (no cadastro ou depois
  /// em "Meu Perfil"). Exibido no painel e na Rede de Associados.
  logoUrl String?

  /// Etapa atual do Portal do Candidato (1 a 7), para salvar/continuar depois.
  wizardStep  Int       @default(1)
  submittedAt DateTime?

  /// Etapa 1 — dados do responsável (nacionalidade, CPF/RG, cargo, endereço, etc.).
  personalData Json?
  /// Etapa 2 — dados da empresa (CNPJ, quadro societário, beneficiários finais, etc.).
  companyData Json?
  /// Etapa 3 — perfil econômico/comercial e diagnóstico de internacionalização.
  businessProfile Json?
  /// Etapa 4 — respostas de compliance e integridade (cada uma com explicação/anexo opcional).
  complianceAnswers Json?
  /// Etapa 5 — documentos enviados (lista de {tipo, nome, url}).
  documents Json?
  /// Etapa 6 — aceites e assinatura eletrônica (nome, cargo, data, IP).
  declarations Json?

  /// Preenchidos pela equipe da Câmara durante a análise de compliance.
  riskLevel          String?
  complianceNotes    String?
  membershipCategory String?
  annualContribution Int?

  /// Resumo de triagem gerado por IA (Claude) a partir dos dados da candidatura —
  /// apoia a análise humana, nunca decide sozinho. Gerado automaticamente no
  /// envio final e pode ser atualizado manualmente pelo admin.
  aiSummary            String?
  aiSummaryGeneratedAt DateTime?

  /// Programa de Fidelidade (Brazil–Oman Chamber Rewards). memberNumber é atribuído
  /// uma única vez, automaticamente, na primeira vez que o status chega a
  /// ACTIVE/APPROVED (ver lib/loyaltyServer.ts). pointsTotal é um cache denormalizado
  /// — a fonte de verdade auditável é a soma de loyaltyTransactions; só deve ser
  /// alterado através de awardBecomeMemberPoints/awardLoyaltyPoints, nunca pelo PATCH
  /// genérico de admin.
  memberNumber String?   @unique
  memberSince  DateTime?
  pointsTotal  Int       @default(0)

  loyaltyTransactions LoyaltyTransaction[]
  eventRegistrations  EventRegistration[]
  benefitRedemptions  BenefitRedemption[]

  @@index([status])
}

/// Histórico de pontos do Programa de Fidelidade — cada linha é um lançamento;
/// a soma de "points" de todas as linhas de um associado deve bater com
/// MembershipApplication.pointsTotal.
model LoyaltyTransaction {
  id            String                @id @default(cuid())
  applicationId String
  application   MembershipApplication @relation(fields: [applicationId], references: [id])

  /// Id do catálogo em src/lib/loyalty.ts (ex. "PARTICIPAR_EVENTO"), ou "CUSTOM"
  /// para lançamentos avulsos digitados pelo admin.
  actionId String
  points   Int
  /// Obrigatório quando actionId = "CUSTOM"; opcional como observação extra nos demais.
  note     String?
  /// "system" = concedido automaticamente (ex. virar associado); "admin" = lançado
  /// manualmente pela equipe da Câmara.
  source    String   @default("admin")
  createdAt DateTime @default(now())

  @@index([applicationId])
  @@index([applicationId, createdAt])
}

enum ApplicationStatus {
  /// Valores legados do fluxo simples anterior (mantidos por compatibilidade).
  PENDING
  APPROVED
  /// Pré-cadastro feito, Portal do Candidato ainda não concluído.
  INCOMPLETE
  /// Formulário concluído, faltam documentos.
  AWAITING_DOCUMENTS
  /// Em análise pela equipe de compliance.
  UNDER_REVIEW
  /// Compliance pediu informações/documentos adicionais ao candidato.
  INFO_REQUESTED
  /// Aprovado com condições a cumprir.
  CONDITIONALLY_APPROVED
  /// Aprovado pela Diretoria, aguardando pagamento da contribuição anual.
  APPROVED_PENDING_PAYMENT
  /// Associado ativo (pagamento confirmado).
  ACTIVE
  REJECTED
  /// Associação ativa, porém suspensa.
  SUSPENDED
}

enum ChamberEventKind {
  EVENTO
  MISSAO
}

/// Eventos e missões empresariais da Câmara, cadastrados pelo admin e exibidos
/// para os associados no Painel do Associado (/membro/painel/eventos e /missoes).
model ChamberEvent {
  id          String           @id @default(cuid())
  kind        ChamberEventKind
  title       String
  description String?
  date        DateTime
  location    String?
  /// Imagem de destaque (card/propaganda) exibida pro associado, enviada via
  /// upload de mídia do admin (mesma infraestrutura do editor de conteúdo).
  imageUrl    String?
  /// Preço da inscrição, em centavos (ex.: 15000 = R$ 150,00). Nulo ou 0 = gratuito.
  /// Guardado em centavos de propósito — é o formato que a API do Stripe espera
  /// (amount), então o campo já fica pronto pra virar um Stripe Checkout Session
  /// quando a cobrança automática for integrada.
  priceCents  Int?
  /// Moeda do valor acima. Sem conversão automática entre BRL/USD — o admin
  /// escolhe a moeda de cobrança de cada evento diretamente (é assim que o
  /// Stripe funciona: cada Checkout Session cobra numa moeda só, sem a Câmara
  /// precisar manter taxa de câmbio própria).
  currency    EventCurrency    @default(BRL)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  registrations EventRegistration[]

  @@index([kind, date])
}

enum RegistrationStatus {
  CONFIRMED
  CANCELLED
}

enum EventCurrency {
  BRL
  USD
}

/// Inscrição de um associado em um evento/missão — alimenta "Próximos compromissos"
/// no Painel do Associado. Autoatendida pelo associado (botão "Inscrever-me"), com
/// status CONFIRMED por padrão; o admin pode cancelar/alterar em /admin/eventos.
model EventRegistration {
  id            String                @id @default(cuid())
  eventId       String
  event         ChamberEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  applicationId String
  application   MembershipApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        RegistrationStatus    @default(CONFIRMED)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([eventId, applicationId])
  @@index([applicationId])
  @@index([eventId])
}

/// Avisos institucionais da Câmara, exibidos no sino de notificações do Painel do
/// Associado. Cadastrados pelo admin em /admin/avisos.
model ChamberNotice {
  id        String   @id @default(cuid())
  title     String
  message   String
  important Boolean  @default(false)
  /// Imagem opcional do aviso (mesma infraestrutura de upload dos outros
  /// cards com imagem — eventos, parceiros).
  imageUrl  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Conta individual de administrador (aba "Usuários" do painel admin). Convive
/// com o login por senha única (ADMIN_PASSWORD, ver /api/admin/login) — esse
/// segue funcionando como acesso "mestre", pra nunca travar o acesso ao admin.
/// FULL = acesso completo ao painel admin (igual à senha mestra).
/// PARTNERS_BENEFITS = só enxerga /admin/beneficios (Parceiros & Benefícios:
/// parceiros, benefícios, categorias, captação) — pra alguém como a
/// secretária trabalhar nisso sem ver pedidos de associação, usuários,
/// conteúdo do site etc.
enum AdminRole {
  FULL
  PARTNERS_BENEFITS
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(FULL)
  createdAt    DateTime  @default(now())
  /// Segredo TOTP (2FA, tipo Google Authenticator) — só existe depois que o
  /// próprio usuário confirma o setup escaneando o QR code. totpEnabled só
  /// vira true nesse momento; até lá o secret é "pendente de confirmação".
  totpSecret   String?
  totpEnabled  Boolean   @default(false)
}

enum ProspectStatus {
  PROSPECTED
  CONTACTED
  NEGOTIATING
  APPROVED
  ACTIVE
  REJECTED
}

/// Funil de captação de parceiros pro módulo "Parceiros & Benefícios" — quadro
/// de trabalho da equipe (ex.: secretária) enquanto negocia com empresas que
/// ainda não são parceiras de verdade. Quando a parceria vira realidade, o
/// cadastro definitivo é feito manualmente em BenefitPartner (sem conversão
/// automática — cada etapa é uma decisão humana).
model PartnerProspect {
  id           String         @id @default(cuid())
  companyName  String
  /// Logo/imagem da empresa prospectada — mostrada no card do funil e
  /// reaproveitada como banner no topo do e-mail de proposta (opcional).
  logoUrl      String?
  category     String?
  country      String?
  city         String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  website      String?
  notes        String?
  status       ProspectStatus @default(PROSPECTED)
  order        Int            @default(0)
  /// Controle do disparo de e-mail em massa (proposta/apresentação) — ver
  /// POST /api/admin/partner-prospects/send-proposal.
  lastProposalSentAt DateTime?
  proposalsSentCount Int       @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status])
}

/// Parceiro/associado em destaque na página pública "Parceiros e Associados"
/// (/parceiros). Curada manualmente pelo admin — nunca preenchida automaticamente
/// com base nos associados pagantes, pra nunca sugerir uma parceria que não existe.
model Partner {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  sector    String?
  website   String?
  /// Ordem de exibição no grid (menor primeiro); empates ficam por nome.
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

/// Nível mínimo de associado exigido pra acessar um benefício. ALL = qualquer
/// associado ativo, independente do nível no Programa de Fidelidade.
enum BenefitEligibility {
  GOLD
  BLACK
  PLATINUM
  ALL
}

enum BenefitType {
  PERCENT_DISCOUNT
  FIXED_DISCOUNT
  SPECIAL_RATE
  UPGRADE
  VIP_PERK
  COURTESY
  CASHBACK
  VOUCHER
  EXCLUSIVE_EXPERIENCE
  PRIORITY_SUPPORT
  OTHER
}

/// Controla quantas vezes o MESMO associado pode clicar em "Usar benefício"
/// (a ação que dispara e-mail com o cupom). SINGLE_USE é o padrão pra
/// benefícios novos — a maioria dos cupons (ex.: CAMARA20) é de uso único por
/// associado; DAILY/WEEKLY/MONTHLY/UNLIMITED existem pra parceiros com
/// benefício recorrente (ex.: "10% de desconto toda vez que for ao restaurante").
enum BenefitFrequency {
  SINGLE_USE
  DAILY
  WEEKLY
  MONTHLY
  UNLIMITED
}

/// Categorias do marketplace "Parceiros & Benefícios" (Hotéis & Resorts,
/// Gastronomia, etc.) — tabela própria (não enum) pra o admin poder criar
/// novas categorias sem precisar de deploy.
model BenefitCategory {
  id       String           @id @default(cuid())
  name     String           @unique
  order    Int              @default(0)
  partners BenefitPartner[]

  @@index([order])
}

/// Empresa parceira do módulo "Parceiros & Benefícios" — marketplace exclusivo
/// pra associados, dentro da própria Área do Associado (não é a mesma coisa
/// que o model Partner, que é a vitrine pública em /parceiros).
model BenefitPartner {
  id               String   @id @default(cuid())
  name             String
  logoUrl          String?
  categoryId       String
  category         BenefitCategory @relation(fields: [categoryId], references: [id])
  country          String
  city             String?
  website          String?
  instagram        String?
  whatsapp         String?
  contactEmail     String?
  shortDescription String?
  fullDescription  String?
  /// ativo/inativo — parceiro inativo não aparece nem conta nos indicadores.
  status           String   @default("active")
  /// Ordem de exibição no grid (menor primeiro).
  order            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  benefits Benefit[]

  @@index([categoryId])
  @@index([status])
  @@index([order])
}

/// Um parceiro pode ter mais de um benefício (ex.: desconto + tarifa especial).
model Benefit {
  id          String             @id @default(cuid())
  partnerId   String
  partner     BenefitPartner     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  title       String
  type        BenefitType
  description String?
  rules       String?
  validFrom   DateTime?
  validUntil  DateTime?
  couponCode  String?
  redeemUrl   String?
  eligibility BenefitEligibility @default(ALL)
  /// Frequência de uso permitida por associado — ver comentário do enum.
  frequency   BenefitFrequency   @default(SINGLE_USE)
  /// Aparece na seção "Destaques" no topo da página do associado.
  featured    Boolean            @default(false)
  status      String             @default("active")
  order       Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  redemptions BenefitRedemption[]

  @@index([partnerId])
  @@index([status])
  @@index([eligibility])
}

/// Registro de cliques em "Ver benefício" / "Usar benefício" / "Gerar cupom" —
/// alimenta os indicadores do admin (benefícios mais acessados, resgates/mês).
model BenefitRedemption {
  id            String                @id @default(cuid())
  benefitId     String
  benefit       Benefit               @relation(fields: [benefitId], references: [id], onDelete: Cascade)
  applicationId String
  application   MembershipApplication @relation(fields: [applicationId], references: [id])
  action        String
  createdAt     DateTime              @default(now())

  @@index([benefitId])
  @@index([applicationId])
  @@index([createdAt])
}

/// Substituições de conteúdo do site (textos/imagens editados pelo admin).
/// Uma única linha (id fixo "singleton"): "data" é um objeto profundo, no mesmo
/// formato de content.ts, contendo só os campos que o admin alterou. O site
/// mescla isso por cima dos padrões de content.ts em tempo de execução
/// (ver lib/contentOverrides.ts) — nunca sobrescreve o código-fonte.
model SiteContent {
  id        String   @id @default("singleton")
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt
}

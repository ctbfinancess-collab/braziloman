# ============================================================
# Câmara de Comércio Brasil–Omã (CTB) — variáveis de ambiente
# Copie este arquivo para ".env" e preencha os valores.
# NUNCA comite o arquivo .env (ele está no .gitignore).
# ============================================================

# Banco de dados PostgreSQL (Railway ou AWS RDS).
# Deixe em branco em desenvolvimento para rodar sem banco
# (o formulário de contato apenas registra em log).
DATABASE_URL="postgresql://usuario:senha@host:5432/braziloman?schema=public"

# URL pública do vídeo institucional do hero (CDN / S3 / CloudFront).
# Em desenvolvimento, se vazio, usa /institucional.mp4 da pasta public.
# Ex.: https://cdn.braziloman.org/institucional.mp4
NEXT_PUBLIC_HERO_VIDEO=""

# Área do Membro — obrigatórias em produção para login funcionar.
# SESSION_SECRET: string aleatória longa (mín. 16 caracteres) usada para assinar
# os cookies de sessão do associado e do admin. Gere uma só vez e nunca a troque
# depois (trocar derruba todas as sessões ativas). Sugestão para gerar:
#   openssl rand -base64 32
SESSION_SECRET=""

# ADMIN_PASSWORD: senha única para acessar /admin/associados (aprovar/rejeitar
# pedidos de associação). Escolha algo forte — não há usuário, só senha.
ADMIN_PASSWORD=""

# E-mails transacionais (Resend). Sem a chave, o site funciona normalmente,
# só não envia e-mails automáticos de cadastro/aprovação (ver lib/email.ts).
# Chave em https://resend.com/api-keys — remetente: contact@brasilomanchamber.org
RESEND_API_KEY=""

# Armazenamento de mídia pública (Cloudflare R2) — fotos do site/painel de conteúdo.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# Bucket PRIVADO separado (sem domínio público!) para documentos sensíveis do
# Portal do Candidato (CPF, passaporte, demonstrações financeiras, etc.).
# Acesso só por link assinado de curta duração (ver lib/media.ts).
# Reutiliza as mesmas credenciais R2 acima, só muda o nome do bucket.
R2_DOCUMENTS_BUCKET=""

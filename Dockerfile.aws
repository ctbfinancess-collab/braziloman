# ============================================================
# CTB — Câmara de Comércio Brasil–Omã
# Imagem de produção para AWS (ECS / App Runner) ou qualquer container.
# Base Debian slim (compatível com Prisma). Railway NÃO usa este arquivo
# (lá o build é via Nixpacks).
# ============================================================

FROM node:22-slim AS base
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# 1) Dependências
FROM base AS deps
COPY package.json package-lock.json ./
RUN npm install --no-audit --no-fund

# 2) Build (gera o Prisma Client e compila o Next.js)
FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# 3) Runner
FROM base AS runner
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
COPY --from=builder /app ./
EXPOSE 3000
CMD ["npm", "run", "start"]
